NODE_ENV=development
PORT=8787
SESSION_SECRET=replace-with-a-long-random-value

# Microsoft Entra app registration
AZURE_TENANT_ID=your-west-monroe-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:8787/auth/callback

# Azure Database for PostgreSQL Flexible Server
DATABASE_URL=postgresql://user:password@host:5432/workboard
DATABASE_SSL=true

# Optional when the frontend and backend run on different origins
VITE_API_BASE_URL=http://localhost:8787

# OpenAI extraction service; keep this server-side only
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Local frontend origin for credentialed browser requests
FRONTEND_ORIGIN=http://localhost:4173

# Temporary localhost-only bridge while Entra is pending
LOCAL_CONNECTOR_IMPORT=true

# Smartsheet source of truth
SMARTSHEET_ACCESS_TOKEN=your-smartsheet-api-access-token
SMARTSHEET_SHEET_ID=cfgw3V4qfMwxH8XjPRFQP46p578vm5Fgc3wFGWF1
SMARTSHEET_APPROVED_STATUS=To do
